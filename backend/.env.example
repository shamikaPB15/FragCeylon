# ------------------------------------------------------------
# FragCeylon backend settings
# Copy this file to ".env" and fill in the real values.
# NEVER commit the real .env file to GitHub.
# ------------------------------------------------------------

# Port the API runs on
PORT=5000

# Frontend URL(s) allowed to call the API (comma separated)
CLIENT_URL=http://localhost:5173

# Gmail account used to SEND the enquiry emails
EMAIL_USER=fragceylonpvtltd@gmail.com
# Gmail App Password (16 characters, NOT the normal Gmail password)
# Google Account -> Security -> 2-Step Verification -> App passwords
EMAIL_PASS=your-16-character-app-password

# Inbox that RECEIVES the website enquiries
EMAIL_TO=fragceylonpvtltd@gmail.com

# Send a "thank you" auto-reply to the customer (true / false)
SEND_AUTO_REPLY=true
